                            },
                            {
                              "type": "text",
                              "id": "4wkOR",
                              "name": "s22c3l",
                              "fill": "#6B5D52",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  มือดี = เล่นดนตรีให้เก่ง\n•  ปากดี = ร้องเพลงดี\n                พูดหนุนใจดี\n•  หูดี = ฟังดนตรี\n            ฟังจังหวะ \n            ฟังกันและกันได้ดี",
                              "lineHeight": 1.6,
                              "fontFamily": "Inter",
                              "fontSize": 58,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
