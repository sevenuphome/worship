              "name": "s2s1t",
              "fill": "#2C2420",
              "content": "1. นำนมัสการคือการพาคนไปพบพระเจ้า",
              "fontFamily": "Inter",
              "fontSize": 83,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "ZGFlH",
              "name": "s2s1b",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 24,
              "padding": [
                0,
                0,
                0,
                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "QrY6u",
                  "name": "s2s1p1",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ผู้นำนมัสการไม่ได้เป็นผู้แสดง แต่เป็น ผู้รับใช้ที่นำที่ประชุมเข้าสู่การทรงสถิตของพระเจ้า",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "14dGc",
                  "name": "s2s1p2",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "เป้าหมายของการนำนมัสการไม่ใช่การทำให้เพลงไพเราะที่สุด แต่คือ การช่วยให้คริสตจักรทั้งที่ประชุมถวายเกียรติแด่พระเจ้า",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "c1jAt",
                  "name": "s2s1p3",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "พระเจ้าทรงแสวงหาผู้นมัสการที่นมัสการพระองค์ \"ด้วยจิตวิญญาณและความจริง\" (ยอห์น 4:23)",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "7vs9e",
          "name": "s2s2",
