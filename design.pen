      "children": [
        {
          "type": "text",
          "id": "uYf14",
          "name": "scrTitle",
          "fill": "#2C2420",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Scripture for Reflection",
          "textAlign": "center",
          "fontFamily": "Playfair Display",
          "fontSize": 100,
          "fontWeight": "normal",
          "fontStyle": "italic"
        },
        {
          "type": "text",
          "id": "hDSvl",
          "name": "scrSub",
          "fill": "#888888",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Please take time to read and reflect before the session begins,\nor read again at home after the training.",
          "lineHeight": 1.6,
          "textAlign": "center",
          "fontFamily": "Inter",
          "fontSize": 58,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "9Z5aT",
          "name": "scrVerses",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 48,
          "children": [
            {
              "type": "frame",
              "id": "ND1Ta",
              "name": "v1",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "5F5y3",
                  "name": "v1ref",
                  "fill": "#B8860B",
                  "content": "John 4:23",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "ZujwM",
                  "name": "v1txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"The Father seeks those who worship Him in spirit and truth.\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
              "type": "frame",
              "id": "1pGx8",
              "name": "v2",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "JPHr5",
                  "name": "v2ref",
                  "fill": "#B8860B",
                  "content": "Psalm 95:6",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "xszkk",
                  "name": "v2txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Come, let us worship and bow down;\nlet us kneel before the Lord our Maker.\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
              "type": "frame",
              "id": "ECFpy",
              "name": "v3",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "yyHCA",
                  "name": "v3ref",
                  "fill": "#B8860B",
                  "content": "Psalm 100:2",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "3mzOW",
                  "name": "v3txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Serve the Lord with gladness;\ncome before His presence with singing.\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
              "type": "frame",
              "id": "N2OoY",
              "name": "v4",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "ZzVIz",
                  "name": "v4ref",
                  "fill": "#B8860B",
                  "content": "Romans 12:1",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "ur95I",
                  "name": "v4txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Offer your bodies to God as a living sacrifice, holy\nand pleasing to God, which is your spiritual worship.\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Et9rv",
              "name": "v5",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "DKH5W",
                  "name": "v5ref",
                  "fill": "#B8860B",
                  "content": "Psalm 150:6",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "8DsMU",
                  "name": "v5txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Let everything that has breath praise the Lord.\nPraise the Lord!\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
              "type": "frame",
              "id": "JBTIC",
              "name": "v6",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "zAe6L",
                  "name": "v6ref",
                  "fill": "#B8860B",
                  "content": "Colossians 3:16",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "HtRCT",
                  "name": "v6txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Teach and admonish one another with all wisdom\nthrough psalms, hymns, and spiritual songs,\nwith thankful hearts to God.\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
              "type": "frame",
              "id": "30WEn",
              "name": "v7",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "bRlUE",
                  "name": "v7ref",
                  "fill": "#B8860B",
                  "content": "Hebrews 13:15",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "kR8RI",
                  "name": "v7txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Let us continually offer to God a sacrifice of praise,\nthe fruit of lips that confess His name.\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            }
          ]
