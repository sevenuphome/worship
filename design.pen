                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "gnX8h",
                              "name": "s22c3t",
                              "fill": "#B8860B",
                              "content": "3 Goods",
                              "fontFamily": "Inter",
                              "fontSize": 48,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "BFwEe",
                              "name": "s22c3l",
                              "fill": "#6B5D52",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Good hands = play skillfully\n•  Good mouth = sing well\n                speak encouragement well\n•  Good ears = listen to the music\n            listen to the rhythm\n            and listen well to one another",
                              "lineHeight": 1.35,
                              "fontFamily": "Inter",
                              "fontSize": 36,
                              "fontWeight": "normal"
                            }
                          ]
