          "children": [
            {
              "type": "text",
              "id": "Cesno",
              "name": "s2s2t",
              "fill": "#2C2420",
              "content": "2. ทีมนมัสการ",
              "fontFamily": "Inter",
              "fontSize": 83,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "tsbgD",
              "name": "s2s2b",
