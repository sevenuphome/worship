          "textGrowth": "fixed-width",
          "width": 2480,
          "content": "3",
          "textAlign": "center",
          "fontFamily": "Inter",
          "fontSize": 42,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
      "id": "jHoky",
      "x": 7740,
      "y": 0,
      "name": "[18pt] Reflections",
      "width": 2480,
      "height": 3508,
      "fill": "#FFFFFF",
      "layout": "vertical",
      "gap": 48,
      "padding": [
        236,
        260,
        354,
        236
      ],
      "children": [
        {
          "type": "text",
          "id": "J4jYG",
          "name": "refTitle",
          "fill": "#2C2420",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "ข้อคิดเกี่ยวกับการนมัสการ",
          "textAlign": "center",
          "fontFamily": "Playfair Display",
          "fontSize": 100,
          "fontWeight": "normal",
          "fontStyle": "italic"
        },
        {
          "type": "text",
          "id": "swZWA",
          "name": "refSub",
          "fill": "#888888",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Reflections on Worship",
          "textAlign": "center",
          "fontFamily": "Inter",
          "fontSize": 75,
          "fontWeight": "normal"
        },
        {
          "type": "rectangle",
          "id": "FH1Uw",
          "layoutPosition": "absolute",
          "x": 726,
          "y": 361,
          "name": "refDiv",
          "fill": "#B8860B",
          "width": 205,
          "height": 2
        },
        {
          "type": "frame",
          "id": "xYQpW",
          "name": "refList",
          "width": "fill_container",
          "height": "fill_container",
          "layout": "vertical",
          "gap": 40,
          "justifyContent": "space_between",
          "children": [
            {
              "type": "frame",
              "id": "Fizgp",
              "name": "q1",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "vGMeF",
                  "name": "q1a",
                  "fill": "#B8860B",
                  "content": "Augustine of Hippo (c. 397–400, Confessions)",
                  "fontFamily": "Inter",
                  "fontSize": 56,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "73yJj",
                  "name": "q1e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"You have made us for yourself, O Lord, and our heart is restless until it rests in you.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "xvia7",
                  "name": "q1t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"พระองค์ทรงสร้างเราเพื่อพระองค์ และหัวใจของเราจะไม่สงบ จนกว่าจะได้พักในพระองค์\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "MV7FI",
              "name": "q2",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "I2OQ4",
                  "name": "q2a",
                  "fill": "#B8860B",
                  "content": "Evelyn Underhill (1936, Worship)",
                  "fontFamily": "Inter",
                  "fontSize": 56,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "AwRHo",
                  "name": "q2e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Worship is the response of the creature to the Eternal.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "w0nFw",
                  "name": "q2t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"การนมัสการคือการตอบสนองของมนุษย์ผู้ถูกสร้างต่อพระเจ้าผู้ทรงนิรันดร์\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "JpMFe",
              "name": "q3",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "C5ElD",
                  "name": "q3a",
                  "fill": "#B8860B",
                  "content": "William Temple (1939, Readings in St John's Gospel)",
                  "fontFamily": "Inter",
                  "fontSize": 56,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "VNwJh",
                  "name": "q3e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Worship is the submission of all our nature to God.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "axcQE",
                  "name": "q3t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"การนมัสการคือการยอมจำนนทั้งชีวิตของเราต่อพระเจ้า\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "szuGH",
              "name": "q4",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "Z6jKr",
                  "name": "q4a",
                  "fill": "#B8860B",
                  "content": "A. W. Tozer (1897–1963)",
                  "fontFamily": "Inter",
                  "fontSize": 56,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "cYxXr",
                  "name": "q4e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Worship is the missing jewel in modern evangelicalism.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "wgXa6",
                  "name": "q4t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"การนมัสการคืออัญมณีที่หายไปในคริสตจักรยุคปัจจุบัน\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "yhVtb",
              "name": "q5",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "vSr98",
                  "name": "q5a",
                  "fill": "#B8860B",
                  "content": "A. W. Tozer (1961, The Purpose of Man)",
                  "fontFamily": "Inter",
                  "fontSize": 56,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "yMcS1",
                  "name": "q5e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"We are saved to worship God. All that Christ has done… leads to this one end.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "MdNvX",
                  "name": "q5t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"เราได้รับความรอดเพื่อจะนมัสการพระเจ้า… ทุกสิ่งที่พระคริสต์ทรงทำ นำไปสู่จุดหมายนี้\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "6y2jz",
              "name": "q6",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "rI1M7",
                  "name": "q6a",
                  "fill": "#B8860B",
                  "content": "John Piper (1983, Let the Nations Be Glad)",
                  "fontFamily": "Inter",
                  "fontSize": 56,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "KrfVA",
                  "name": "q6e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Missions exists because worship doesn't.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "J8VK4",
                  "name": "q6t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"พันธกิจมีอยู่ เพราะการนมัสการยังไม่เกิดขึ้น\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "nFuBU",
          "layoutPosition": "absolute",
          "x": 0,
          "y": 3400,
          "name": "p4",
          "fill": "#6B5D52",
          "textGrowth": "fixed-width",
          "width": 2480,
          "content": "4",
          "textAlign": "center",
          "fontFamily": "Inter",
          "fontSize": 42,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
