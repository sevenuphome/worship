            }
          ]
        },
        {
          "type": "frame",
          "id": "Xhc0y",
          "name": "s3sec",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 30,
          "children": [
            {
              "type": "text",
              "id": "r4irr",
              "name": "s3sect",
              "fill": "#2C2420",
              "content": "3. The Worship Leader",
              "fontFamily": "Inter",
              "fontSize": 75,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "mwp5a",
              "name": "s3body",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 30,
              "padding": [
                0,
                0,
                0,
                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "jeDt4",
                  "name": "s31t",
                  "fill": "#2C2420",
                  "content": "3.1 The Role of a Worship Leader",
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "LZIlH",
                  "name": "s31l",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Lead the congregation into God's presence\n•  Create an atmosphere of worship\n•  Prepare listeners' hearts to receive the Word\n•  Coordinate the music team and congregation to sing together",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "kr3ft",
                  "name": "sec32",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 30,
                  "padding": [
                    40,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "aQoCy",
                      "name": "s32t",
                      "fill": "#2C2420",
                      "content": "3.2 The Life of the Worship Leader Matters More Than Ability",
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "J5d1C",
                      "name": "s32p",
                      "fill": "#6B5D52",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A worship leader must be a worshiper before becoming a leader. They should have:",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "r0bWC",
                      "name": "s32l",
                      "fill": "#6B5D52",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "•  A life close to God\n•  A personal worship life\n•  Spiritual growth\n•  A life that sets an example",
                      "lineHeight": 1.7,
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Fx8qo",
                  "name": "hlWrap",
                  "width": "fill_container",
                  "layout": "vertical",
                  "padding": [
                    30,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "frame",
                      "id": "lMi4q",
                      "name": "s32hl",
                      "width": "fill_container",
                      "fill": "#F5F1EB",
                      "stroke": {
                        "thickness": {
                          "left": 3
                        },
                        "fill": "#B8860B"
                      },
                      "layout": "vertical",
                      "gap": 8,
                      "padding": [
                        14,
                        20
                      ],
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "fDdAS",
                          "name": "s32hlt",
                          "fill": "#6B5D52",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Musical ability matters",
                          "lineHeight": 1.6,
                          "textAlign": "center",
                          "fontFamily": "Inter",
                          "fontSize": 75,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "6uWm9",
                          "name": "s32hlb",
                          "fill": "#2C2420",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "but a heart that loves God matters more",
                          "textAlign": "center",
                          "fontFamily": "Inter",
                          "fontSize": 75,
                          "fontWeight": "700"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "text",
