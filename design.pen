      "fill": "#FFFFFF",
      "layout": "vertical",
      "gap": 28,
      "padding": [
        236,
        260,
        354,
        236
      ],
      "children": [
        {
          "type": "frame",
          "id": "oNFpq",
          "name": "s1hdr",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 12,
          "alignItems": "center",
          "children": [
            {
              "type": "text",
              "id": "aJdNT",
              "name": "s1label",
              "fill": "#B8860B",
              "content": "Session 1",
              "fontFamily": "Inter",
              "fontSize": 75,
              "fontWeight": "600",
              "letterSpacing": 2
            },
            {
              "type": "text",
              "id": "Njz84",
              "name": "s1title",
              "fill": "#2C2420",
              "content": "หัวใจของการนมัสการ",
              "textAlign": "center",
              "fontFamily": "Playfair Display",
              "fontSize": 100,
              "fontWeight": "normal",
              "fontStyle": "italic"
            }
          ]
        },
        {
          "type": "frame",
          "id": "G3O2a",
          "name": "sec1",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 22,
          "children": [
            {
              "type": "text",
              "id": "TKc2o",
              "name": "sec1t",
              "fill": "#2C2420",
              "content": "1. หัวใจและความสำคัญของการนมัสการ",
              "fontFamily": "Inter",
              "fontSize": 75,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "DuSBM",
              "name": "sec1b1",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 30,
              "padding": [
                0,
                0,
                0,
                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "rzQI4",
                  "name": "sec1p1",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "การนมัสการ คือ ศูนย์กลางของชีวิตคริสเตียน",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "jpL9C",
                  "name": "sec1p2",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "สิ่งต่าง ๆ ในโลกนี้จะผ่านไป แต่สิ่งหนึ่งที่เราทำตอนนี้ \nและจะทำต่อไปในสวรรค์ คือ การนมัสการพระเจ้า",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "HM6w6",
                  "name": "sec1p3",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "การนมัสการไม่ใช่แค่กิจกรรมในคริสตจักร \nแต่คือเหตุผลที่เราถูกสร้างมา\nและการนมัสการที่แท้จริง คือ ความสัมพันธ์กับพระเจ้า ไม่ใช่พิธีกรรม",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "129JK",
                  "name": "sec1p4",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "พระเจ้าเท่านั้นที่สมควรได้รับการนมัสการ เพราะพระองค์คือพระผู้สร้าง พระบิดาของเรา ผู้ให้ชีวิตและลมหายใจแก่เรา ผู้เชื่อจึงต้องไม่นมัสการสิ่งอื่นหรือพระอื่นใดเลย แต่ต้องถวายการนมัสการแด่พระเจ้าองค์เดียวเท่านั้น",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "TPDjt",
          "name": "quote1",
          "width": "fill_container",
          "fill": "#F5F1EB",
          "stroke": {
            "thickness": {
              "left": 3
            },
            "fill": "#B8860B"
          },
          "layout": "vertical",
          "gap": 10,
          "padding": [
            16,
            24
          ],
          "children": [
            {
              "type": "text",
              "id": "ABVlD",
              "name": "quote1t",
              "fill": "#2C2420",
              "textGrowth": "fixed-width",
              "width": "fill_container",
