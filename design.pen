                  "name": "v3ref",
                  "fill": "#B8860B",
                  "content": "สดุดี 100:2",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "lTh5R",
                  "name": "v3txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"จงปรนนิบัติพระยาห์เวห์ด้วยความยินดี\nจงเข้ามาเฝ้าพระองค์ด้วยการร้องเพลง\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
              "type": "frame",
              "id": "lYqWB",
              "name": "v4",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "PGiAY",
                  "name": "v4ref",
                  "fill": "#B8860B",
                  "content": "โรม 12:1",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "dmDGQ",
                  "name": "v4txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"จงถวายตัวของท่านแด่พระเจ้าเป็นเครื่องบูชาที่มีชีวิต บริสุทธิ์\nและเป็นที่พอพระทัยพระเจ้า ซึ่งเป็นการนมัสการโดยวิญญาณของท่าน\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
              "type": "frame",
              "id": "QPkIN",
              "name": "v5",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "U2LQB",
                  "name": "v5ref",
                  "fill": "#B8860B",
                  "content": "สดุดี 150:6",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "FN1Pv",
                  "name": "v5txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"ให้ทุกสิ่งที่มีลมหายใจสรรเสริญพระยาห์เวห์\nจงสรรเสริญพระยาห์เวห์เถิด\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
              "type": "frame",
              "id": "irCz2",
              "name": "v6",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "dQuae",
                  "name": "v6ref",
                  "fill": "#B8860B",
                  "content": "โคโลสี 3:16",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "NOdHc",
                  "name": "v6txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"จงสอนและเตือนสติกันด้วยปัญญาทั้งสิ้น\nโดยร้องเพลงสดุดี เพลงสรรเสริญ และเพลงฝ่ายวิญญาณ\nด้วยใจขอบพระคุณพระเจ้า\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
              "type": "frame",
              "id": "nDlZd",
              "name": "v7",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "HqnQL",
                  "name": "v7ref",
                  "fill": "#B8860B",
                  "content": "ฮีบรู 13:15",
                  "fontFamily": "Inter",
                  "fontSize": 50,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "wTFm9",
                  "name": "v7txt",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"เพราะฉะนั้น ให้เราถวายคำสรรเสริญเป็นเครื่องบูชาแด่พระเจ้าอยู่เสมอ\nคือผลของริมฝีปากที่กล่าวยกย่องพระนามของพระองค์\"",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 58,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "zU3JD",
          "layoutPosition": "absolute",
          "x": 0,
          "y": 3400,
          "name": "p3",
