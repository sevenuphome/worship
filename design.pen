            }
          ]
        },
        {
          "type": "frame",
          "id": "xvrzg",
          "name": "s2s1",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 24,
          "children": [
            {
              "type": "text",
              "id": "hp1vn",
              "name": "s2s1t",
              "fill": "#2C2420",
              "content": "1. Worship Leading Means Leading People to Meet God",
              "fontFamily": "Inter",
              "fontSize": 75,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "H9P9C",
              "name": "s2s1b",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 24,
              "padding": [
                0,
                0,
                0,
                24
              ],
              "children": [
                {
                  "type": "text",
                  "id": "uRP65",
                  "name": "s2s1p1",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A worship leader is not a performer...\nbut a servant who leads the congregation into God's presence.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "tKhQS",
                  "name": "s2s1p2",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The goal of worship leading is not to make the music sound as beautiful as possible,\nbut to help the whole church give glory to God together.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "aqUH3",
          "name": "s2s2",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 24,
          "padding": [
            60,
            0,
            0,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "FgpxO",
              "name": "s2s2t",
              "fill": "#2C2420",
              "content": "2. The Worship Team",
              "fontFamily": "Inter",
              "fontSize": 75,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "dRmFu",
              "name": "s2s2b",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 24,
              "padding": [
                0,
                0,
                0,
                24
              ],
              "children": [
                {
                  "type": "text",
                  "id": "9oUFf",
                  "name": "s2s2_21",
                  "fill": "#2C2420",
                  "content": "2.1 The worship team is important to church life",
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "zX6Mh",
                  "name": "s2s2_21l",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A worship team is not only the worship leader, but also includes singers, musicians,\nsound team members, media, and worship coordinators.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "CDKUM",
                  "name": "s2s2_21p",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "All of them are important parts that help worship happen with quality and bring glory to God.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "Jd1PW",
                  "name": "s2s2b_cont",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 24,
                  "padding": [
