                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ร้องเพลงซ้ำ\nหยุดเงียบเพื่ออธิษฐาน\nอาจเปลี่ยนทิศทางเล็กน้อยจากที่เตรียม\nสังเกตการตอบสนองของที่ประชุม",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 83,
