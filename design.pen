                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "rzQI4",
                  "name": "sec1p1",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "การนมัสการ คือ ศูนย์กลางของชีวิตคริสเตียน",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "jpL9C",
                  "name": "sec1p2",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "สิ่งต่าง ๆ ในโลกนี้จะผ่านไป แต่สิ่งหนึ่งที่เราทำตอนนี้ \nและจะทำต่อไปในสวรรค์ คือ การนมัสการพระเจ้า",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "HM6w6",
                  "name": "sec1p3",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "การนมัสการไม่ใช่แค่กิจกรรมในคริสตจักร \nแต่คือเหตุผลที่เราถูกสร้างมา\nและการนมัสการที่แท้จริง คือ ความสัมพันธ์กับพระเจ้า ไม่ใช่พิธีกรรม",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "129JK",
                  "name": "sec1p4",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "พระเจ้าเท่านั้นที่สมควรได้รับการนมัสการ เพราะพระองค์คือพระผู้สร้าง พระบิดาของเรา ผู้ให้ชีวิตและลมหายใจแก่เรา ผู้เชื่อจึงต้องไม่นมัสการสิ่งอื่นหรือพระอื่นใดเลย แต่ต้องถวายการนมัสการแด่พระเจ้าองค์เดียวเท่านั้น",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "TPDjt",
          "name": "quote1",
          "width": "fill_container",
          "fill": "#F5F1EB",
