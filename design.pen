              "content": "Song Types",
              "fontFamily": "Playfair Display",
              "fontSize": 83,
              "fontWeight": "normal",
              "fontStyle": "italic"
            },
            {
              "type": "frame",
              "id": "gAs4g",
              "name": "sec41",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 18,
              "children": [
                {
                  "type": "text",
                  "id": "w7voB",
                  "name": "s41t",
                  "fill": "#2C2420",
                  "content": "4.1 Songs of Praise / Exaltation (Praise)",
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "usIzx",
                  "name": "s41d",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Content: Declares that God is great, good, and faithful.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "APuIr",
                  "name": "s41b",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "    Often used to open worship\n    Creates an atmosphere of joyful praise\n    Examples: 10,000 Reasons, How Great Is Our God",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "oQS44",
                  "name": "s41check",
                  "width": "fill_container",
                  "fill": "#F5F1EB",
                  "stroke": {
                    "thickness": {
                      "left": 3
                    },
                    "fill": "#B8860B"
                  },
                  "layout": "vertical",
                  "gap": 8,
                  "padding": [
                    12,
                    20
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "SIfMi",
                      "name": "s41ql",
                      "fill": "#B8860B",
                      "content": "Check Question:",
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "PEv5f",
                      "name": "s41qv",
                      "fill": "#6B5D52",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What is this song saying about God?",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "RWEUb",
              "name": "sec42",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 18,
              "padding": [
                50,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "b0EsT",
                  "name": "s42t",
                  "fill": "#2C2420",
                  "content": "4.2 Celebration / Joy Songs",
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "gidX7",
                  "name": "s42d",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Content: Celebrates God's goodness and rejoices in Him.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "YMMG9",
                  "name": "s42b",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "    Often upbeat and high-energy\n    Suitable for the opening or middle section\n    Examples: Shout to the Lord, Happy Day",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "Ok41O",
                  "name": "s42check",
                  "width": "fill_container",
                  "fill": "#F5F1EB",
                  "stroke": {
                    "thickness": {
                      "left": 3
                    },
                    "fill": "#B8860B"
                  },
                  "layout": "vertical",
                  "gap": 8,
                  "padding": [
                    12,
                    20
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "4CqTG",
                      "name": "s42ql",
                      "fill": "#B8860B",
                      "content": "Check Question:",
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "USy0Z",
                      "name": "s42qv",
                      "fill": "#6B5D52",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Does this song lead people to rejoice in what God has done?",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
