          "fontSize": 83,
          "fontWeight": "normal"
        },
        {
          "type": "rectangle",
          "id": "pCFqx",
          "layoutPosition": "absolute",
          "x": 1138,
          "y": 309,
          "name": "refDiv",
          "fill": "#C4994C",
          "width": 205,
          "height": 2
        },
        {
          "type": "frame",
          "id": "L9qIJ",
          "name": "refList",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 40,
          "children": [
            {
              "type": "frame",
              "id": "rUOpn",
              "name": "q1",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "etdfX",
                  "name": "q1a",
                  "fill": "#C4994C",
                  "content": "Augustine of Hippo (c. 397–400, Confessions)",
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "hHiNi",
                  "name": "q1e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"You have made us for yourself, O Lord, and our heart is restless until it rests in you.\"",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "NYlKw",
                  "name": "q1t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"พระองค์ทรงสร้างเราเพื่อพระองค์ และหัวใจของเราจะไม่สงบ จนกว่าจะได้พักในพระองค์\"",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wfctr",
              "name": "q2",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "gr8Er",
                  "name": "q2a",
                  "fill": "#C4994C",
                  "content": "Evelyn Underhill (1936, Worship)",
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "XDUru",
                  "name": "q2e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Worship is the response of the creature to the Eternal.\"",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "HkE1S",
                  "name": "q2t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"การนมัสการคือการตอบสนองของมนุษย์ผู้ถูกสร้างต่อพระเจ้าผู้ทรงนิรันดร์\"",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "gVTTB",
              "name": "q3",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "QIR92",
                  "name": "q3a",
                  "fill": "#C4994C",
                  "content": "William Temple (1939, Readings in St John's Gospel)",
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "r8an5",
                  "name": "q3e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Worship is the submission of all our nature to God.\"",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "xmrTS",
                  "name": "q3t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"การนมัสการคือการยอมจำนนทั้งชีวิตของเราต่อพระเจ้า\"",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "q7GKh",
              "name": "q4",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "s7u7a",
                  "name": "q4a",
                  "fill": "#C4994C",
                  "content": "A. W. Tozer (1897–1963)",
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Uu4n9",
                  "name": "q4e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Worship is the missing jewel in modern evangelicalism.\"",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "1P2SZ",
                  "name": "q4t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"การนมัสการคืออัญมณีที่หายไปในคริสตจักรยุคปัจจุบัน\"",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
