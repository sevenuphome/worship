                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "QrSEm",
                  "name": "box2d",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "การอธิษฐานมีพลังเปลี่ยนแปลงทุกสิ่ง ความสามารถของมนุษย์เปลี่ยนได้แค่บางเรื่อง แต่การอธิษฐานสามารถเปลี่ยนแปลง\nสิ่งต่าง ๆ ได้อย่างอัศจรรย์ จงอธิษฐานอยู่เสมอ อย่าท้อใจ ถ้าจำเป็นก็อดอาหารอธิษฐาน การฟื้นฟูเกิดจากหัวเข่าที่อธิษฐาน",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                }
              ]
            },
