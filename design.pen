              "fill": "#2C2420",
              "content": "Worship Leading (2)",
              "textAlign": "center",
              "fontFamily": "Playfair Display",
              "fontSize": 100,
              "fontWeight": "normal",
              "fontStyle": "italic"
            }
          ]
        },
        {
          "type": "frame",
          "id": "fquDr",
          "name": "wb2",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 20,
          "padding": [
            60,
            0,
            0,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "dO54u",
              "name": "wb2t",
              "fill": "#2C2420",
              "content": "2. Lead the Atmosphere",
              "fontFamily": "Inter",
              "fontSize": 75,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "snzUt",
              "name": "wb2b",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 22,
              "padding": [
                0,
                0,
                0,
                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "YbIzB",
                  "name": "wb2p1",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Know where you are leading the people\n•  Help worship flow without interruption",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "oTSdw",
                  "name": "hlBox",
                  "width": "fill_container",
                  "fill": "#F5F1EB",
                  "stroke": {
                    "thickness": {
                      "left": 3
                    },
                    "fill": "#B8860B"
                  },
                  "layout": "vertical",
                  "padding": [
                    12,
                    20
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "jFN5P",
                      "name": "hlText",
                      "fill": "#2C2420",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Worship must have freedom, but not confusion.",
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "600"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "MaRrJ",
          "name": "wb2l",
          "fill": "#B8860B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Everything should be done properly and in order\n(1 Cor. 14:40 - Let all things be done properly and in order.)",
          "lineHeight": 1.6,
          "fontFamily": "Inter",
          "fontSize": 75,
          "fontWeight": "normal",
          "fontStyle": "italic"
        },
        {
          "type": "text",
          "id": "oFxjl",
          "name": "wb2para",
          "fill": "#6B5D52",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The leader may invite the congregation to stand, clap, or sing together,\nbut should not force people all the time. Space should be given for each person to respond to God appropriately under the orderly leading of the Holy Spirit.",
          "lineHeight": 1.6,
          "fontFamily": "Inter",
          "fontSize": 75,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "bIWqX",
          "layoutPosition": "absolute",
          "x": 0,
          "y": 3400,
          "name": "l21",
          "fill": "#6B5D52",
          "textGrowth": "fixed-width",
          "width": 2480,
          "content": "21",
          "textAlign": "center",
          "fontFamily": "Inter",
          "fontSize": 42,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
      "id": "az8o2",
      "x": 54180,
      "y": 5000,
      "name": "p2",
      "width": 2480,
      "height": 3508,
      "fill": "#FFFFFF",
      "layout": "vertical",
      "gap": 70,
      "padding": [
        236,
        260,
        354,
        236
      ],
      "children": [
        {
          "type": "frame",
          "id": "nEKoy",
          "name": "hdr3",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 12,
          "alignItems": "center",
          "children": [
            {
              "type": "text",
              "id": "EVW0F",
              "name": "lab3",
              "fill": "#B8860B",
              "content": "Workshop B",
              "fontFamily": "Inter",
              "fontSize": 75,
              "fontWeight": "600",
              "letterSpacing": 2
            },
            {
              "type": "text",
              "id": "ndTF6",
              "name": "ttl3",
              "fill": "#2C2420",
              "content": "Worship Leading (3)",
              "textAlign": "center",
              "fontFamily": "Playfair Display",
              "fontSize": 100,
              "fontWeight": "normal",
              "fontStyle": "italic"
            }
          ]
        },
        {
          "type": "frame",
          "id": "lGeAf",
          "name": "wb3_new",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 16,
          "children": [
            {
              "type": "text",
              "id": "ZIIlW",
              "name": "sec3t",
              "fill": "#2C2420",
              "content": "3. Be Open to the Holy Spirit's Leading and Work as a Team",
              "fontFamily": "Inter",
              "fontSize": 75,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "I1Xm6",
              "name": "sec3b",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 14,
              "padding": [
                0,
                0,
                0,
                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "z9ikj",
                  "name": "sec3p1",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Even with good preparation,\na worship leader should remain sensitive to the leading of the Holy Spirit.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "3uUgT",
                  "name": "sec3q",
                  "width": "fill_container",
                  "fill": "#F5F1EB",
                  "stroke": {
                    "thickness": {
                      "left": 3
                    },
                    "fill": "#B8860B"
                  },
                  "layout": "vertical",
                  "padding": [
                    12,
                    20
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "wYgeT",
                      "name": "sec3qt",
                      "fill": "#2C2420",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"We have our plans... but God has His way.\"",
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "500"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "7JbLu",
                  "name": "sec3l",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "So in practice, we may...\n     repeat a song\n     pause in silence for prayer\n     adjust direction slightly from what was prepared\n     observe the congregation's response",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "HJ9iI",
          "name": "wb_sec4",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 16,
          "padding": [
            30,
            0,
            0,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "M8H0b",
              "name": "sec4t",
              "fill": "#2C2420",
              "content": "4. Choosing Songs",
              "fontFamily": "Inter",
              "fontSize": 65,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "z0xFK",
              "name": "sec4b",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 14,
              "padding": [
                0,
                0,
                0,
                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "XdarV",
                  "name": "sec4intro",
                  "fill": "#6B5D52",
                  "content": "There are many kinds of worship songs.",
                  "fontFamily": "Inter",
                  "fontSize": 65,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "AVqCX",
                  "name": "sec4p1",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Songs used in worship should keep God at the center.\nThey should speak of God's character, what He has done,\nHis greatness, love, grace, holiness, and power.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 65,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "5yhtY",
                  "name": "p2",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Encouragement songs can be used, but they should serve as a supplement, not the main focus,\nbecause the center of worship is God, not us.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 65,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "OZN17",
                  "name": "vs_box",
                  "width": "fill_container",
                  "fill": "#F5F1EB",
                  "cornerRadius": 8,
                  "stroke": {
                    "thickness": {
                      "left": 3
                    },
                    "fill": "#B8860B"
                  },
                  "layout": "vertical",
                  "gap": 10,
                  "padding": [
                    24,
                    28
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "Q1lDL",
                      "name": "vstitle",
                      "fill": "#2C2420",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Songs About God vs. Songs About Us or Others",
                      "fontFamily": "Inter",
                      "fontSize": 65,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "TrXLi",
                      "name": "vstext",
                      "fill": "#6B5D52",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A good worship song should be directed to God or speak about Him.\nSongs that speak to people, such as encouragement songs or challenge songs, also have their place,\nbut they should be chosen with balance, while keeping God-centered songs primary.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 65,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "vhzG0",
          "layoutPosition": "absolute",
          "x": 0,
          "y": 3400,
