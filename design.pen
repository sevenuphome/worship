                  "name": "wb1p1",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ผู้นำนมัสการต้องช่วยให้ ทั้งคริสตจักรนมัสการร่วมกัน",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "hggqF",
                  "name": "quoteBox",
                  "width": "fill_container",
