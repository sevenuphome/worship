                    0,
                    0,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "kXKo6",
                      "name": "s22t",
                      "fill": "#2C2420",
                      "content": "2.2 Qualities of a Good Worship Team",
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "600"
                    },
                    {
                      "type": "frame",
