                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Prayer\n•  Reading Scripture\n•  Giving\n•  Serving\n•  Witnessing\n•  Living a life that brings glory to God",
                  "lineHeight": 1.8,
                  "fontFamily": "Inter",
                  "fontSize": 75,
