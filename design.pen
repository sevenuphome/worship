                              "name": "s22c2t",
                              "fill": "#B8860B",
                              "content": "3 ใจ",
                              "fontFamily": "Inter",
                              "fontSize": 60,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "NPinK",
                              "name": "s22c2l",
                              "fill": "#6B5D52",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  เต็มใจรับใช้\n•  มั่นใจในของประทาน\n    ที่พระเจ้าให้\n•  รับใช้สุดใจ สุดกำลัง\n    สุดความสามารถ",
                              "lineHeight": 1.6,
                              "fontFamily": "Inter",
