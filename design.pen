                {
                  "type": "text",
                  "id": "gRYbo",
                  "name": "q8e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"True worship is a lifestyle, not just a song.\"",
