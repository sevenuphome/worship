                  "name": "box3t",
                  "fill": "#C4994C",
                  "content": "การนมัสการ (เสียงเพลง)",
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "MQ2cv",
                  "name": "box3d",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "พระคัมภีร์สนับสนุนการใช้เสียงเพลงและดนตรี พระคัมภีร์กล่าวถึงการสรรเสริญพระเจ้าด้วยเครื่องดนตรีหลายครั้ง โดยเฉพาะสดุดี 150 ที่เรียกให้ทุกสิ่งที่มีลมหายใจสรรเสริญพระเจ้า",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
