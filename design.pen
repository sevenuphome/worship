              "gap": 50,
              "padding": [
                0,
                0,
                0,
                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "iB3PU",
                  "name": "wb1p1",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A worship leader must help the whole church worship together.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "p6YsZ",
                  "name": "quoteBox",
                  "width": "fill_container",
                  "fill": "#F5F1EB",
                  "stroke": {
                    "thickness": {
                      "left": 3
                    },
                    "fill": "#B8860B"
                  },
                  "layout": "vertical",
                  "padding": [
                    12,
                    20
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "sMcpE",
                      "name": "quoteText",
                      "fill": "#2C2420",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"A good leader is not the one who sings the best,\nbut the one who makes others want to sing along.\"",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "500"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "PhebZ",
                  "name": "considerText",
                  "fill": "#2C2420",
                  "content": "Things to consider when choosing songs:",
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "dUrc9",
                  "name": "wb1l",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Choose a key that is easy to sing\nSing clearly and lead the rhythm clearly\nSpeak briefly and concisely\nSpeak words that encourage the congregation",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "7mK2q",
                  "name": "wb1hl",
                  "width": "fill_container",
                  "fill": "#F5F1EB",
                  "stroke": {
                    "thickness": {
                      "left": 3
                    },
                    "fill": "#B8860B"
                  },
                  "layout": "vertical",
                  "padding": [
                    12,
                    20
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "74g0V",
                      "name": "wb1hlt",
                      "fill": "#2C2420",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Worship is not a performance by the team on stage, but the shared worship of the whole church.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "500"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "7okgy",
          "layoutPosition": "absolute",
          "x": 0,
          "y": 3400,
          "name": "l20",
          "fill": "#6B5D52",
          "textGrowth": "fixed-width",
          "width": 2480,
          "content": "20",
          "textAlign": "center",
          "fontFamily": "Inter",
          "fontSize": 42,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
