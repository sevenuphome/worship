              ],
              "children": [
                {
                  "type": "text",
                  "id": "MPoZY",
                  "name": "s2s1p1",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ผู้นำนมัสการไม่ได้เป็นผู้แสดง... \nแต่เป็นผู้รับใช้ที่นำที่ประชุมเข้าสู่การทรงสถิตของพระเจ้า",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "8Jz8V",
                  "name": "s2s1p2",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "เป้าหมายของการนำนมัสการ ไม่ใช่การทำให้เพลงไพเราะที่สุด \nแต่คือการช่วยให้คริสตจักรทั้งที่ประชุมถวายเกียรติแด่พระเจ้า",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
