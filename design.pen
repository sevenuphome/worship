                  "name": "s25t",
                  "fill": "#2C2420",
                  "content": "2.5 ดนตรีและการร้องควร \"ไพเราะ\" และ \"ไหลลื่น\"",
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "600"
