                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "H0isx",
                  "name": "box1d",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "พระคำของพระเจ้าสำคัญมาก ถ้าไม่มีพระคำ ผู้เชื่อจะไม่รู้ว่าอะไรถูกอะไรผิด และอาจถูกคำสอนผิดหลอกได้ ผู้พูดหนุนใจให้คริสเตียนอ่านพระคัมภีร์ทุกวัน รักพระคำ และให้พระคำหยั่งรากลึกในชีวิต",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal"
                }
              ]
