                  "name": "q9t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"มนุษย์ทุกคนต่างมีสิ่งที่ตนเองนมัสการอยู่เสมอ\"",
                  "lineHeight": 1.45,
