              ]
            },
            {
              "type": "frame",
              "id": "ZLE3r",
              "name": "sec24",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 24,
              "padding": [
                40,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "aURx7",
                  "name": "s24t",
                  "fill": "#2C2420",
                  "content": "2.4 The Goal of the Worship Team",
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "plExU",
                  "name": "s24intro",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The goal is not just to finish the songs, but to:",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 68,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "trXHT",
                  "name": "s24l",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Lead the congregation into God's presence\n•  Let worship flow smoothly\n•  Help people in the congregation encounter God\n•  Allow the Holy Spirit to work",
                  "lineHeight": 1.55,
                  "fontFamily": "Inter",
                  "fontSize": 68,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "vvhSp",
              "name": "sec25",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 24,
              "padding": [
                40,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "CwlkG",
                  "name": "s25t",
                  "fill": "#2C2420",
                  "content": "2.5 Music and Singing Should Be \"Beautiful\" and \"Smooth\"",
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "1HZep",
                  "name": "s25intro",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Good music helps people want to worship more, so attention should be given to:",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 68,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "usTui",
                  "name": "s25l",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Correct chords\n•  Correct rhythm\n•  A good intro\n•  Smooth song transitions\n•  A key that suits the leader and the congregation\n•  Music that is not too crowded\n•  Appropriate arrangement",
                  "lineHeight": 1.55,
                  "fontFamily": "Inter",
                  "fontSize": 68,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
