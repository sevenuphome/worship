                          "padding": [
                            12,
                            16
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "paCPA",
                              "name": "s22c1t",
                              "fill": "#B8860B",
                              "content": "3 Ready",
                              "fontFamily": "Inter",
                              "fontSize": 48,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "Dxr2r",
                              "name": "s22c1l",
                              "fill": "#6B5D52",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Spirit ready\n•  Team ready\n•  Equipment ready",
                              "lineHeight": 1.45,
                              "fontFamily": "Inter",
                              "fontSize": 42,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "zHFE4",
                          "name": "s22c2",
                          "width": "fill_container",
                          "fill": "#F5F1EB",
                          "layout": "vertical",
                          "gap": 10,
                          "padding": [
                            12,
                            16
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "RrbIt",
                              "name": "s22c2t",
                              "fill": "#B8860B",
                              "content": "3 Hearts",
                              "fontFamily": "Inter",
                              "fontSize": 48,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "7mgXS",
                              "name": "s22c2l",
                              "fill": "#6B5D52",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Willing to serve\n•  Confident in the gifts\n    God has given\n•  Serving with all your heart, strength,\n    and ability",
                              "lineHeight": 1.4,
                              "fontFamily": "Inter",
                              "fontSize": 40,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "chO6Y",
                          "name": "s22c3",
                          "width": "fill_container",
                          "fill": "#F5F1EB",
