          "children": [
            {
              "type": "text",
              "id": "DxIEo",
              "name": "s23t",
              "fill": "#2C2420",
              "content": "2.3 The worship team needs both \"skill\" and \"anointing\"",
              "fontFamily": "Inter",
              "fontSize": 75,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "jF3ku",
              "name": "s23intro",
              "fill": "#6B5D52",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "These two must go together:",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
