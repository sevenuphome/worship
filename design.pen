              "gap": 32,
              "padding": [
                0,
                0,
                0,
                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "a6ULM",
                  "name": "s2s2_21",
                  "fill": "#2C2420",
                  "content": "2.1 ทีมนมัสการมีความสำคัญต่อชีวิตคริสตจักร",
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "CHrw5",
                  "name": "s2s2_21l",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ทีมนมัสการไม่ได้มีแค่ผู้นำนมัสการ แต่รวมถึง: นักร้อง, นักดนตรี, ช่างเสียง, มีเดีย, ผู้ดูแลการนมัสการ",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "60DTR",
                  "name": "s2s2_21p",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ทั้งหมดเป็นส่วนสำคัญในการช่วยให้การนมัสการเป็นไปอย่างมีคุณภาพและถวายเกียรติแด่พระเจ้า",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 83,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
