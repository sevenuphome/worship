                  "id": "ulzgs",
                  "name": "q2a",
                  "fill": "#B8860B",
                  "content": "Evelyn Underhill (1936, Worship)",
                  "fontFamily": "Inter",
                  "fontSize": 56,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "yRfdP",
                  "name": "q2e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Worship is the response of the creature to the Eternal.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
