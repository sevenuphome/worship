                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Worship is the joyful response of hearts that have been set free.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "bbbRv",
              "name": "q11",
              "width": "fill_container",
