                {
                  "type": "text",
                  "id": "e1BPC",
                  "name": "sec2p1",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Many people think worship means \"singing songs,\"\nbut in reality, songs are only one part of it.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 75,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
