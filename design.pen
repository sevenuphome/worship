          "name": "wb2para",
          "fill": "#6B5D52",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "ผู้นำสามารถเชิญชวนที่ประชุมให้ยืน ตบมือ หรือร่วมร้องเพลงได้ แต่ไม่ควรบังคับตลอดเวลา ควรเปิดโอกาสให้แต่ละคนตอบสนองต่อพระเจ้าอย่างเหมาะสม ภายใต้การทรงนำของพระวิญญาณบริสุทธิ์อย่างเป็นระเบียบ",
          "lineHeight": 1.6,
          "fontFamily": "Inter",
          "fontSize": 83,
          "fontWeight": "normal"
        },
