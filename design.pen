                  "fontSize": 56,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "WB3eC",
                  "name": "q3e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Worship is the submission of all our nature to God.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
