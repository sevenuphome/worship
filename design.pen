              "children": [
                {
                  "type": "text",
                  "id": "w8XyE",
                  "name": "q1a",
                  "fill": "#B8860B",
                  "content": "Augustine of Hippo (c. 397–400, Confessions)",
                  "fontFamily": "Inter",
                  "fontSize": 56,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Z8RqX",
                  "name": "q1e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"You have made us for yourself, O Lord, and our heart is restless until it rests in you.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wATVN",
              "name": "q2",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
