                }
              ]
            },
            {
              "type": "frame",
              "id": "NywZR",
              "name": "q10",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "TZfVH",
                  "name": "q10a",
                  "fill": "#B8860B",
                  "content": "N. T. Wright (2006, Simply Christian)",
                  "fontFamily": "Inter",
                  "fontSize": 56,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "l9RwO",
                  "name": "q10e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Worship is the glad response of hearts that have been set free.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "ib8es",
                  "name": "q10t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"การนมัสการคือการตอบสนองด้วยความยินดีของหัวใจที่ได้รับการปลดปล่อย\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "TyPeN",
              "name": "q11",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "WkS4p",
                  "name": "q11a",
                  "fill": "#B8860B",
                  "content": "Taya Smith (Hillsong United, c. 2015)",
                  "fontFamily": "Inter",
                  "fontSize": 56,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "B7SoQ",
                  "name": "q11e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"It's not about how it sounds, it's about the heart behind it.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "hH6HM",
                  "name": "q11t",
                  "fill": "#2C2420",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"การนมัสการไม่สำคัญว่ามันเพราะแค่ไหน แต่คือหัวใจที่อยู่เบื้องหลัง\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 60,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "3QfA5",
              "name": "q12",
              "width": "fill_container",
              "layout": "vertical",
