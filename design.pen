                    "thickness": {
                      "left": 3
                    },
                    "fill": "#B8860B"
                  },
                  "layout": "vertical",
                  "padding": [
                    12,
                    20
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "ShXfe",
                      "name": "quoteText",
                      "fill": "#2C2420",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"ผู้นำที่ดี ไม่ใช่คนที่ร้องเก่งที่สุด\nแต่คือคนที่ทำให้คนอื่น 'อยากร้องตาม'\"",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 75,
                      "fontWeight": "500"
                    }
                  ]
                },
