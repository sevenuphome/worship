                },
                {
                  "type": "text",
                  "id": "ZcoG0",
                  "name": "q11e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"It's not about how it sounds, it's about the heart behind it.\"",
