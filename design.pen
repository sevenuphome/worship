                  "name": "q4e",
                  "fill": "#6B5D52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Worship is the missing jewel in modern evangelicalism.\"",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
